# AvtoNet Garage & Valuation Engine Configuration

# Application Port & Mode
VITE_APP_PORT=3002
VITE_APP_ENV=development

# Automotive Scraping / Ingestion Gateway URL
VITE_AVTONET_API_BASE_URL=https://api.avtonet.flegartech.com/v1

# Currency & Metric Defaults
VITE_DEFAULT_CURRENCY=EUR
VITE_DEFAULT_ODOMETER_UNIT=KM

# Depreciation Model Tuning Constants
VITE_ANNUAL_DEPRECIATION_RATE=0.12
VITE_AVERAGE_KM_PER_YEAR=15000
